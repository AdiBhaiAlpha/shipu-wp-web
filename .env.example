# Server-side secrets for the Render backend. Never commit the real .env.

# Firebase Admin SDK: a service-account JSON string, or a path to the file.
FIREBASE_ADMIN_CREDENTIALS=

# HMAC secret for purchase sessions and payment webhooks.
PAYMENT_SECRET=
WEBHOOK_SECRET=

# Where the static site is served from (used for CORS / links).
SHIPU_WEB_URL=
